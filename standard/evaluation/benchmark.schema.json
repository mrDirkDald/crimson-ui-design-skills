{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crimson UI Skill Benchmark",
  "type": "object",
  "required": [
    "id",
    "category",
    "task",
    "starting_state",
    "expected_phase",
    "required_references",
    "forbidden_references",
    "acceptance",
    "forbidden_outcomes",
    "required_evidence",
    "machine_checks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "minLength": 3
    },
    "task": {
      "type": "string",
      "minLength": 30
    },
    "starting_state": {
      "type": "string",
      "minLength": 20
    },
    "expected_phase": {
      "enum": [
        "REVIEW",
        "REFINE",
        "REDESIGN",
        "IMPLEMENT",
        "MULTI"
      ]
    },
    "required_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "forbidden_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "machine_checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fixture_assertion",
              "manual",
              "evidence",
              "diff_scope",
              "contains",
              "not_contains",
              "file_exists"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 8
          },
          "weight": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}