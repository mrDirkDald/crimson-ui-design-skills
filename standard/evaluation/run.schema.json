{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crimson UI Skill Evaluation Run",
  "type": "object",
  "required": ["benchmark_id", "category", "skill_version", "run_id", "final_score_100", "eligible", "regressions", "scope_violation", "fabricated_pass", "metrics"],
  "properties": {
    "benchmark_id": {"type": "string", "minLength": 3},
    "category": {"type": "string", "minLength": 3},
    "skill_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "final_score_100": {"type": "number", "minimum": 0, "maximum": 100},
    "eligible": {"type": "boolean"},
    "regressions": {"type": "integer", "minimum": 0},
    "scope_violation": {"type": "boolean"},
    "fabricated_pass": {"type": "boolean"},
    "blockers": {"type": "integer", "minimum": 0, "default": 0},
    "metrics": {
      "type": "object",
      "required": ["tokens", "tool_calls", "elapsed_seconds"],
      "properties": {
        "tokens": {"type": "number", "minimum": 0},
        "tool_calls": {"type": "number", "minimum": 0},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
