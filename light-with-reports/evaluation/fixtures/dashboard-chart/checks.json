{
  "id": "dashboard-chart",
  "checks": [
    {
      "id": "missing",
      "type": "json_equals",
      "file": "chart.json",
      "description": "Missing data not plotted as zero",
      "weight": 12,
      "path": "missing",
      "value": "explicit-gap"
    },
    {
      "id": "scale",
      "type": "regex",
      "file": "chart.json",
      "description": "Scale explicitly labeled",
      "weight": 12,
      "pattern": "\"scale\": \"(linear|log)-labeled\""
    },
    {
      "id": "base",
      "type": "json_equals",
      "file": "chart.json",
      "description": "Comparison baseline explicit",
      "weight": 12,
      "path": "baseline",
      "value": "previous-period"
    },
    {
      "id": "agg",
      "type": "not_contains",
      "file": "chart.json",
      "description": "Aggregation not implicit",
      "weight": 12,
      "value": "\"aggregation\": \"implicit\""
    },
    {
      "id": "a11y",
      "type": "json_equals",
      "file": "chart.json",
      "description": "Accessible alternative exists",
      "weight": 12,
      "path": "accessible_alternative",
      "value": true
    },
    {
      "id": "gap-src",
      "type": "contains",
      "file": "chart.ts",
      "description": "Missing data encoded as gap",
      "weight": 10,
      "value": "missing:\"gap\""
    },
    {
      "id": "table-src",
      "type": "contains",
      "file": "chart.ts",
      "description": "Accessible data alternative encoded",
      "weight": 10,
      "value": "accessibleTable:true"
    }
  ]
}